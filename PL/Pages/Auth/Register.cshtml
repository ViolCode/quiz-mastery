@page
@model PL.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h3 class="text-center mb-4">Register</h3>
            <form method="post" novalidate>
                <div class="mb-3">
                    <label>Name</label>
                    <input asp-for="RegisterUser.Name" class="form-control" required />
                    <span asp-validation-for="RegisterUser.Name"></span>
                </div>
                <div class="mb-3">
                    <label>Email</label>
                    <input asp-for="RegisterUser.Email" class="form-control" required />
                    <span asp-validation-for="RegisterUser.Email"></span>
                </div>
                <div class="mb-3">
                    <label>Password</label>
                    <input asp-for="RegisterUser.PasswordHash" type="password" class="form-control" required />
                    <span asp-validation-for="RegisterUser.PasswordHash"></span>
                </div>
                <div class="mb-3">
                    <label>Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
                <div class="mb-3">
                    <label>Role</label>
                    <select asp-for="RegisterUser.RoleId" asp-items="Model.Roles" class="form-control"></select>
                </div>
                <button type="submit" class="btn btn-success w-100">Register</button>
            </form>
            <p class="mt-3 text-center">
                <a asp-page="/Auth/Login">Already registered? Login</a>
            </p>
            <div asp-validation-summary="All" class="text-danger"></div>
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-warning text-center">
                    @TempData["Message"]
                </div>
            }

        </div>
    </div>
</div>