@page
@model PL.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-page bg-light">
    <div class="container">
        <div class="auth-form">
            <div class="text-center mb-4">
                <h1 class="fw-bold text-foreground">Quiz Mastery</h1>
                <p class="text-muted">Register to get started</p>
            </div>

            <form method="post" novalidate>
                <div class="mb-3">
                    <label>Name</label>
                    <input asp-for="RegisterUser.Name" class="form-control" placeholder="Your full name" />
                    <span asp-validation-for="RegisterUser.Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label>Email</label>
                    <input asp-for="RegisterUser.Email" type="email" class="form-control" placeholder="you@school.edu" />
                    <span asp-validation-for="RegisterUser.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label>Password</label>
                    <input asp-for="RegisterUser.PasswordHash" type="password" class="form-control" />
                    <span asp-validation-for="RegisterUser.PasswordHash" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label>Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label>Role</label>
                    <select asp-for="RegisterUser.Role" asp-items="Model.Roles" class="form-select"></select>
                    <span asp-validation-for="RegisterUser.Role" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Register
                </button>

                <p class="mt-4 text-center">
                    <a asp-page="/Auth/Login" class="fw-semibold text-decoration-none text-primary">Already registered? Login</a>
                </p>

                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-warning text-center mt-3 rounded-lg">
                        @TempData["Message"]
                    </div>
                }
            </form>
        </div>
    </div>
</div>
