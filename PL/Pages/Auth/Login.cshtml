@page
@model PL.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-page bg-light">
    <div class="container">
        <div class="auth-form">
            <h3 class="text-center mb-4">Login</h3>

            <form method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small" style="list-style:none;"></div>

                <div class="mb-3">
                    <label>Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="you@school.edu" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label>Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Your password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>

            <p class="mt-4 text-center">
                <a asp-page="/Auth/Register" class="fw-semibold text-decoration-none text-primary">Don't have an account yet? Register</a>
            </p>

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-warning text-center mt-3 rounded-lg">
                    @TempData["Message"]
                </div>
            }
        </div>
    </div>
</div>