@page
@model PL.Pages.Teacher.TeacherDashboardModel
@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "Teacher Dashboard";
}

<head>
    <title>Teacher Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Teacher Dashboard</h2>
                <p class="text-muted mb-0">Welcome @Model.CurrentUser.Name (@Model.CurrentUser.Email, @Model.CurrentUser.RoleName)</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-page="/Teacher/CreateQuiz" class="btn btn-primary">Create Quiz</a>
            </div>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-warning text-center">
                @TempData["Message"]
            </div>
        }
    </div>
</body>