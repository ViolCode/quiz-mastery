@page
@model PL.Pages.Teacher.CreateQuizModel
@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "Create Quiz";
}

<!-- Sticky Top Bar -->
<div class="sticky-top bg-white border-bottom shadow-sm">
    <div class="container-fluid px-4 py-3 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h4 fw-bold mb-0">Create Quiz</h1>
            <small class="text-muted">Build and manage your quiz</small>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-eye me-1"></i> Preview
            </button>
            <button type="submit" form="quiz-form" class="btn btn-primary btn-sm">
                <i class="bi bi-send me-1"></i> Publish
            </button>
        </div>
    </div>
</div>

<div class="container-fluid px-4 py-4">
    <div class="row g-4">

        <!-- Main Content -->
        <div class="col-lg-8">

            <form method="post" id="quiz-form" class="d-grid gap-4">

                <!-- Quiz Title -->
                <div class="card border-2 shadow-sm">
                    <div class="card-body">
                        <label class="form-label fw-semibold">
                            Quiz Title <span class="text-danger">*</span>
                        </label>
                        <input asp-for="QuizTitle"
                               class="form-control form-control-lg"
                               placeholder="Enter your quiz title..." />
                        <span asp-validation-for="QuizTitle" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Question Card -->
                <div class="card border-2 shadow-sm">
                    <div class="card-body">

                        <div class="d-flex align-items-center mb-3">
                            <span class="badge bg-secondary me-2">Q1</span>
                            <div class="ms-auto text-muted small">
                                Required
                            </div>
                        </div>

                        <label class="form-label fw-semibold">
                            Question Text <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="QuestionText"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter your question..."></textarea>
                        <span asp-validation-for="QuestionText" class="text-danger small"></span>

                        <!-- Options -->
                        <div class="mt-4">
                            <label class="form-label fw-semibold">
                                Options <span class="text-danger">*</span>
                            </label>

                            @for (int i = 0; i < Model.Options.Count; i++)
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <input type="radio"
                                           class="form-check-input"
                                           name="CorrectOptionIndex"
                                           value="@i"
                                           @(Model.CorrectOptionIndex == i ? "checked" : "") />

                                    <input class="form-control"
                                           name="Options[@i]"
                                           value="@Model.Options[i]"
                                           placeholder="Option @(i + 1)" />

                                    <span class="badge bg-light text-muted">Correct</span>
                                </div>
                            }

                            <span class="text-danger small">@Model.OptionError</span>
                        </div>

                    </div>
                </div>

            </form>

        </div>

        <!-- Right Sidebar -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 100px">

                <button class="btn btn-primary w-100 mb-3">
                    <i class="bi bi-plus-lg me-1"></i> Add Question
                </button>

                <div class="card border-2 shadow-sm">
                    <div class="card-body">

                        <h5 class="fw-semibold mb-3">Assignment & Privacy</h5>

                        <!-- Due Date -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Due Date</label>
                            <input type="date" class="form-control" />
                        </div>

                        <!-- Privacy -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Privacy</label>

                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-outline-secondary text-start">
                                    Public (everyone)
                                </button>
                                <button type="button" class="btn btn-outline-secondary text-start">
                                    Private (assigned only)
                                </button>
                                <button type="button" class="btn btn-outline-secondary text-start">
                                    Link-only
                                </button>
                            </div>
                        </div>

                        <!-- Assign -->
                        <div>
                            <label class="form-label fw-semibold">Assign to</label>
                            <input class="form-control"
                                   placeholder="Select students or groups..." />
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
