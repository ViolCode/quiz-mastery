@page
@model PL.Pages.Teacher.CreateQuizModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Create Quiz";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-1">Create Quiz</h2>
                    <p class="text-muted mb-0">Single-answer questions</p>
                </div>
                <a asp-page="/Teacher/TeacherDashboard" class="btn btn-link text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">Quiz title</label>
                            <input asp-for="QuizTitle" class="form-control" placeholder="Enter the quiz title" />
                            <span asp-validation-for="QuizTitle" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Question</label>
                            <textarea asp-for="QuestionText" class="form-control" rows="3" placeholder="Enter the question text"></textarea>
                            <span asp-validation-for="QuestionText" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between">
                                <span>Answer options</span>
                                <small class="text-muted">Select the correct one</small>
                            </label>

                            @for (int i = 0; i < Model.Options.Count; i++)
                            {
                                <div class="input-group mb-2">
                                    <div class="input-group-text">
                                        <input class="form-check-input mt-0" type="radio" name="CorrectOptionIndex" value="@i" @(Model.CorrectOptionIndex == i ? "checked" : "") />
                                    </div>
                                    <input class="form-control" name="Options[@i]" value="@Model.Options[i]" placeholder="Option @(i + 1)" />
                                </div>
                            }
                            <span class="text-danger small">@Model.OptionError</span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save Quiz</button>
                            <a asp-page="/Teacher/TeacherDashboard" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success mt-4">
                    @TempData["Message"]
                </div>
            }
        </div>
    </div>
</div>

