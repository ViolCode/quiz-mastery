@page
@model PL.Pages.Teacher.MyQuizzesModel
@{
    Layout = "_TeacherLayout";
    ViewData["Title"] = "My Quizzes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Quizzes</h2>
    <a asp-page="/Teacher/CreateQuiz" class="btn btn-primary">
        Create New Quiz
    </a>
</div>

@if (!Model.Quizzes.Any())
{
    <div class="alert alert-info">
        You have not created any quizzes yet.
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var quiz in Model.Quizzes)
            {
                <tr>
                    <td>@quiz.Title</td>
                    <td>@quiz.CreatedAt.ToLocalTime().ToShortDateString()</td>
                    <td class="text-end">
                        <a class="btn btn-outline-secondary btn-sm">
                            View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
