@page
@model PL.Pages.Student.TakeQuizModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Take quiz";

}

<form method="post">
    <h3>@Model.Quiz.Title</h3>

    @for (int q = 0; q < Model.Quiz.Questions.Count; q++)
    {
        <div class="card p-3 mb-3">
            <h5>@Model.Quiz.Questions[q].Text</h5>

            @foreach (var ans in Model.Quiz.Questions[q].Answers)
            {
                <div class="form-check">
                    <input type="radio" name="Answers[@q]" value="@ans.AnswerId" required />
                    <label>@ans.Text</label>
                </div>
            }

            <input type="hidden" name="QuestionIds[@q]" value="@Model.Quiz.Questions[q].QuestionId" />
        </div>
    }

    <input type="hidden" name="AttemptId" value="@Model.AttemptId" />
    <input type="hidden" name="AssignmentId" value="@Model.Quiz.AssignmentId" />

    <button type="submit" class="btn btn-primary">
        Submit Quiz
    </button>
</form>
