@page
@model PL.Pages.Student.MyAssignmentsModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "My Assignments";
}

<h2 class="mb-4">My Assignments</h2>

@if (!Model.Assignments.Any())
{
    <div class="alert alert-info">
        You have no assigned quizzes.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var assignment in Model.Assignments)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">@assignment.Title</h5>

                        <p class="text-muted small">
                            Assigned on @assignment.AssignedAt.ToLocalTime().ToShortDateString()
                        </p>

                        @* Here you currently check TempData *@
                        @if (TempData[$"Message_{assignment.AssignmentId}"] != null)
                        {
                            <div class="alert alert-warning">
                                @TempData[$"Message_{assignment.AssignmentId}"]
                            </div>
                        }

                        <a asp-page="/Student/TakeQuiz"
                           asp-route-assignmentId="@assignment.AssignmentId"
                           class="btn btn-primary btn-sm">
                            Start Quiz
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
